# ==============================================================================
# TIMEBANK OF INDIA 🇮🇳 - OPTIONAL EXTERNAL SMS & EMAIL GATEWAY CONFIGURATION
# ==============================================================================
# By default, TimeBank of India delivers OTPs via high-clarity In-App Simulation
# directly into the user interface so anyone can test with 0 configuration or fees.
# 
# If you wish to send REAL physical SMS to Indian mobile numbers (+91) or real emails,
# copy this file to .env.local and populate your credentials below:

# ------------------------------------------------------------------------------
# OPTION 1: Fast2SMS (India's Premier SMS Gateway)
# Free trial available at https://www.fast2sms.com
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY=

# ------------------------------------------------------------------------------
# OPTION 2: Twilio SMS (Global Telecom Gateway)
# Sign up at https://www.twilio.com
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# OPTION 3: Resend (Modern Email Delivery)
# Sign up at https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=
